{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RunReceipt",
  "type": "object",
  "required": [
    "run_id",
    "command",
    "skill_version",
    "started_at",
    "finished_at",
    "changes",
    "warnings",
    "conflicts",
    "revision"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "command": {
      "type": "string"
    },
    "skill_version": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "changes": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revision": {
      "type": "object",
      "required": [
        "before",
        "after"
      ],
      "properties": {
        "before": {
          "type": "integer"
        },
        "after": {
          "type": "integer"
        }
      }
    }
  }
}
