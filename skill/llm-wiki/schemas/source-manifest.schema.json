{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SourceManifest",
  "type": "object",
  "required": [
    "id",
    "kind",
    "origin",
    "versions",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^source_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "kind": {
      "enum": [
        "file",
        "url",
        "repository",
        "session",
        "text",
        "directory"
      ]
    },
    "origin": {
      "type": "string"
    },
    "root_origin": {
      "type": [
        "string",
        "null"
      ]
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "version",
          "sha256",
          "captured_at",
          "adapter"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "captured_at": {
            "type": "string"
          },
          "raw_path": {
            "type": "string"
          },
          "normalized_path": {
            "type": "string"
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "adapter": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "created_at": {
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  }
}
